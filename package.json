{
  "name": "rwa-crowdfund-stellar",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace backend run build && npm --workspace frontend run build",
    "setup": "npm --workspace backend run setup",
    "test": "npm --workspace backend run test && npm --workspace frontend run test && npm run test:ui-kit",
    "test:ui-kit": "node --test brand/ui-kit/components/cards/funding-math.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.7.3",
    "typescript-eslint": "^8.46.4"
  }
}
