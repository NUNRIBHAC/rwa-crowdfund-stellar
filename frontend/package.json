{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "i18n:export": "node scripts/i18n-export.mjs && node scripts/i18n-mail.mjs export",
    "i18n:import": "node scripts/i18n-import.mjs && node scripts/i18n-mail.mjs import",
    "i18n:check": "node scripts/i18n-export.mjs --check && node scripts/i18n-import.mjs --check && node scripts/i18n-mail.mjs check && node scripts/i18n-whitespace-guard.mjs --check",
    "i18n:repair": "node scripts/i18n-weblate-repair.mjs"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.8.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
