{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "setup": "tsx src/setup.ts",
    "demo": "tsx src/demo.ts",
    "reset": "node scripts/reset.mjs",
    "test": "NODE_ENV=test node --import tsx --test --experimental-test-coverage --test-coverage-lines=91 --test-coverage-branches=80 --test-coverage-functions=80 test/*.test.ts",
    "infra:dev": "tsx src/infrastructure/server.ts",
    "infra:demo": "tsx scripts/demo-infrastructure.ts",
    "infra:test": "NODE_ENV=test tsx --test test/infrastructure.test.ts"
  },
  "dependencies": {
    "@farcaster/auth-client": "0.7.1",
    "@stellar/stellar-sdk": "^17.4.0",
    "@types/pdfkit": "^0.17.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "openid-client": "^6.8.9",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "viem": "2.57.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
