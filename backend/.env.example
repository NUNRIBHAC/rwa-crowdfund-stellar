# Stellar network
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# USDC testnet (Circle SAC) — issuer locked (skill sozu-faucet)
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Sozu faucet (testnet Circle USDC)
SOZU_FAUCET_URL=https://faucet.sozu.capital

# Platform account (escrow). Generate with:
#   node -e "console.log(require('@stellar/stellar-sdk').Keypair.random().secret())"
PLATFORM_SECRET=

# Admin key for money-moving endpoints (/finalize, /refund, /retry-pending,
# /demo/seed-investors). Sent by the UI as the x-admin-key header.
# Demo-grade shared secret, testnet only; `npm run setup` generates one if empty.
ADMIN_SECRET=

# API port
PORT=4000

# Bind locally by default. For hosting, use a TLS reverse proxy and set an
# exact browser-origin allowlist. No wildcard and no trailing slash.
HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Soroban is the active campaign flow. Registration does not deploy or migrate.
SOROBAN_CAMPAIGNS_JSON=[]
# Example entry: {"id":"solar-1","name":"Solar test","contractId":"<verified C... contract ID>"}
# Durable local signed-intent journal (one API process only)
SOROBAN_INTENTS_PATH=./data/soroban-intents.json

# Canonical public origin used in sitemap.xml/robots.txt. Optional on Render
# (RENDER_EXTERNAL_URL is injected); set when fronting with a custom domain.
# PUBLIC_ORIGIN=https://blockallisto-demo.onrender.com
